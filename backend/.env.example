# ==============================================================================
# TruthLens Backend Environment Configuration
# ==============================================================================
# DO NOT COMMIT REAL SECRETS OR API KEYS TO GIT.
# Copy this file to .env and provide your actual Gemini API key.

# Port for Express API server
PORT=8000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated or single URL)
FRONTEND_ORIGIN=http://localhost:5173

# Request Timeout in Milliseconds (default: 30000)
REQUEST_TIMEOUT_MS=30000

# Groq API Configuration (Primary Intelligence Provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_AUDIO_MODEL=whisper-large-v3

# Google Gemini API Configuration (Optional Secondary Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Fact Check Tools API (Optional - free API key, falls back to GEMINI_API_KEY if omitted)
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here
