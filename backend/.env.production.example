# ==============================================================================
# TruthLens Backend Production Environment Configuration
# ==============================================================================

PORT=8000
NODE_ENV=production

# Allowed Frontend Origins for CORS (comma-separated domains or IP addresses)
FRONTEND_ORIGIN=https://truthlens.app,http://localhost

# Global Request Timeout in Milliseconds (90 seconds recommended for multimodal AI)
REQUEST_TIMEOUT_MS=90000

# Google Gemini API Configuration (Google AI Studio Key)
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Fact Check Tools API Key
# GOOGLE_FACTCHECK_API_KEY=your_optional_factcheck_key
