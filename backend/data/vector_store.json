    {
      "id": "kb-fin-001#chunk-0",
      "docId": "kb-fin-001",
      "chunkIndex": 0,
      "text": "SBI never sends links over SMS asking customers to update KYC. Official KYC updates are conducted strictly through official SBI branches or the official SBI YONO mobile app. Cyber criminals are circulating deceptive SMS and WhatsApp messages claiming that user YONO bank accounts have been blocked due to outdated KYC documents and urging recipients to click external links under threat of financial penalty.",
      "source_name": "State Bank of India Official Security Advisory",
      "url": "https://sbi.co.in/",
      "published_date": "2024-05-18",
      "trust_tier": "TIER_1_OFFICIAL_GOV",
      "domain": "sbi.co.in",
      "title": "State Bank of India & RBI Advisory: Fake KYC Expiration and Account Block SMS Alerts",
