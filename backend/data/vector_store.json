    {
      "id": "kb-health-001#chunk-0",
      "docId": "kb-health-001",
      "chunkIndex": 0,
      "text": "There is no scientific basis to claim an alkaline diet or consuming sodium bicarbonate neutralizes or cures cancer in humans. Dietary changes cannot alter systemic blood pH. Human blood pH is strictly regulated by the kidneys and respiratory system within a narrow pH range of 7.35 to 7.45 regardless of food or beverage intake.",
      "source_name": "American Cancer Society",
      "url": "https://www.cancer.org/treatment/treatments-and-side-effects/complementary-and-alternative-medicine.html",
      "published_date": "2023-04-12",
      "trust_tier": "TIER_1_AUTHORITATIVE_ORG",
      "domain": "cancer.org",
      "title": "American Cancer Society: Alkaline Diets, Baking Soda, and Cancer Cell Myths",
