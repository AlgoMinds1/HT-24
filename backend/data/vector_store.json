    {
      "id": "kb-fin-001#chunk-2",
      "docId": "kb-fin-001",
      "chunkIndex": 2,
      "text": "The Reserve Bank of India and SBI emphasize that banks will never ask customers to verify passwords, debit card PINs, CVV, or one-time passwords through SMS web links. Customers must never share login credentials, OTPs, or debit card PINs on external portals or links received via SMS. If you receive such an SMS, do not click the link and immediately report the incident to the official national cyber crime portal.",
      "source_name": "State Bank of India Official Security Advisory",
      "url": "https://sbi.co.in/",
      "published_date": "2024-05-18",
      "trust_tier": "TIER_1_OFFICIAL_GOV",
      "domain": "sbi.co.in",
