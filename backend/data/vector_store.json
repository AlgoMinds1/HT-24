    {
      "id": "kb-gov-001#chunk-1",
      "docId": "kb-gov-001",
      "chunkIndex": 1,
      "text": "Fraudulent messages frequently share deceptive web addresses claiming that students who passed 10th or 12th standards can register for free laptops by submitting Aadhaar numbers and personal contact information. The Press Information Bureau cautions citizens that the Central Government runs no scheme titled PM Free Laptop Distribution Scheme. Official academic support and scholarship programs are managed strictly through verified domains such as scholarships.gov.in.",
      "source_name": "PIB Fact Check (Government of India)",
      "url": "https://factcheck.pib.gov.in/",
      "published_date": "2021-11-04",
      "trust_tier": "TIER_1_OFFICIAL_GOV",
      "domain": "pib.gov.in",
      "title": "PIB Fact Check: Viral Messages Claiming Free Laptop Distribution Under Government Scheme Are Fake",
