# ==============================================================================
# TruthLens Environment Variables Template
# ==============================================================================
# DO NOT COMMIT REAL API KEYS OR SECRETS TO SOURCE CONTROL.
# Copy this file to .env and replace placeholders with your actual keys.

# Environment Mode
NODE_ENV=development
PORT=3000
BACKEND_PORT=8000

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fact-Checking & Search APIs
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_custom_search_engine_id_here
BING_SEARCH_API_KEY=your_bing_search_api_key_here
FACTCHECK_API_KEY=your_factcheck_tools_api_key_here

# Vector Store / Knowledge Base (Optional)
CHROMA_DB_URL=http://localhost:8000
QDRANT_API_KEY=your_qdrant_api_key_here
